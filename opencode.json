{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "edit": {
      "./**": "allow"
    },
    "read": {
      "*": "allow"
    },
    "skill": {
      "caveman": "allow"
    },
    "glob": {
      "./**": "allow"
    },
    "bash": {
      "find *": "allow",
      "grep *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git grep *": "allow",
      "cat *": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow"
  }
}
